# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_…) or the legacy service_role key. SERVER ONLY — never put it in the Next.js app.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_…) or the legacy anon key. Used only to sign users in.
SUPABASE_PUBLISHABLE_KEY=

# Port the API listens on (the dashboard proxies /api/* here; see API_URL in ../.env.example)
PORT=4000

# Public URL(s) of the dashboard, comma-separated. Requests that change data must come from here.
ALLOWED_ORIGINS=http://localhost:3001

# Set to "production" when deployed (enables Secure cookies)
NODE_ENV=development
