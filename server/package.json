{
  "name": "eec-dashboard-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Supabase API for the Essential English Course dashboard (tuition payments, students, teachers).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
