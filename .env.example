# Where the Express API (server/) runs. Next.js proxies /api/* to it, so the
# browser only ever talks to this app and the login cookies just work.
# Local default: http://localhost:4000
API_URL=http://localhost:4000

# Public URL of this dashboard (no trailing slash). Link previews on WhatsApp,
# Telegram, LinkedIn and X need it for the full image URL. On Vercel it falls
# back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
